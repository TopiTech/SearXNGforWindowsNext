# ==============================================================================
# SearXNG for Windows Next - Git Ignore Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Python bytecode, caches, and build artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
pip-wheel-metadata/

# Testing and linting caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/
.tox/
.nox/

# ------------------------------------------------------------------------------
# Embedded Python environment (Windows Native)
# ------------------------------------------------------------------------------
# Ignore embedded Python third-party packages, except whitelisted core libraries
/python/Lib/site-packages/*
!/python/Lib/site-packages/searx/
!/python/Lib/site-packages/searx/**
!/python/Lib/site-packages/searxng_extra/
!/python/Lib/site-packages/searxng_extra/**
!/python/Lib/site-packages/valkey/
!/python/Lib/site-packages/valkey/**

# Keep pip, setuptools, and wheel in repository for bootstrap installation
!/python/Lib/site-packages/pip/
!/python/Lib/site-packages/pip-*.dist-info/
!/python/Lib/site-packages/setuptools/
!/python/Lib/site-packages/setuptools-*.dist-info/
!/python/Lib/site-packages/wheel/
!/python/Lib/site-packages/wheel-*.dist-info/

# Always ignore bytecode even inside whitelisted packages
**/__pycache__/
**/*.py[cod]
**/*$py.class

# Embedded Python scripts directory: pip entry points and local console shims
# (Console shims contain machine-local paths and are generated via install-requirements)
/python/Scripts/*
!/python/Scripts/pip.exe
!/python/Scripts/pip3.exe
!/python/Scripts/pip3.11.exe

# ------------------------------------------------------------------------------
# Local Configuration and Secrets
# ------------------------------------------------------------------------------
# The tracked template is config/settings.yml.example.
# config/settings.yml is generated on first run and customised by user.
# config/secret.key holds the per-install Flask secret_key and must NEVER be tracked.
/config/settings.yml
/config/settings.yml.bak
/config/secret.key
/config/secret_key

# Environment files and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# ------------------------------------------------------------------------------
# Temporary files, logs, and patch caches
# ------------------------------------------------------------------------------
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*.orig
*~
.upstream-tmp/
changed_files.txt
.patches_cache.json
.patches_report.json
.patches_backup/
/scratch/
python/.patches_cache.json
python/.patches_report.json
python/.patches_backup/

# ------------------------------------------------------------------------------
# Operating System files
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Linux
*~

# ------------------------------------------------------------------------------
# IDE, Editor, and Tool configurations
# ------------------------------------------------------------------------------
# Visual Studio / VS Code
.vscode/*
!.vscode/settings.json.example
!.vscode/launch.json.example
*.suo
*.user
*.userosv
*.sln.docstates
.vs/

# JetBrains (PyCharm, IntelliJ, etc.)
.idea/
*.iml
*.iws

# Sublime Text
*.sublime-workspace
*.sublime-project

# ------------------------------------------------------------------------------
# AI Agent Workspaces, Sessions, and Local Metadata
# ------------------------------------------------------------------------------
.agent/
.agents/teamwork/
.commandcode/
.freebuff/
.claude/
.cursor/
.windsurf/
